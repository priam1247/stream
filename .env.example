# Copy this file to `.env` next to bot.py and edit the two lines you care about.
#
#   panel:  Files -> upload as /home/container/.env
#   local:  cp .env.example .env
#
# `.env` is git-ignored, so these values are never committed or shared.
# Real environment variables always win over this file.

# --- login for the web page -------------------------------------------------
# Leave both empty on first run: the app generates a password and prints it
# once in the console. Set them to keep a fixed one.
SCRIBD_WEB_USER=me
SCRIBD_WEB_PASS=change-me-to-something-long

# --- your Scribd session ----------------------------------------------------
# Optional. If unset, ./cookies.txt (next to bot.py) is used automatically.
# Upload that file with the panel's Files tab; never commit it.
# SCRIBD_WEB_COOKIES=/home/container/cookies.txt

# --- where the PDFs and job logs go -----------------------------------------
# SCRIBD_WEB_DATA=/home/container/webdata

# --- download Chromium automatically on the first boot ----------------------
# Equivalent to pressing "Install Chromium" in the page. ~150 MB, once.
SCRIBD_WEB_AUTO_BROWSER=0

# --- how many jobs at a time -------------------------------------------------
# Keep 1 on a small panel: every job is its own headless Chromium.
SCRIBD_WEB_CONCURRENCY=1

# --- Chromium launch (only if the default fails) -----------------------------
# The app already tries the headless shell, then full Chrome, and remembers
# which worked. Force one with: shell | chrome | path
# SCRIBD_BROWSER_MODE=chrome
# Extra Chromium flags, space separated
# SCRIBD_BROWSER_ARGS=--font-render-hinting=none
# Keep the Chromium sandbox (drop --no-sandbox); fails in most containers
# SCRIBD_BROWSER_SANDBOX=0

# --- Chromium's system libraries (only if launch fails on libnspr4/libnss3) ---
# The page's button fetches them automatically into webdata/sysroot.
# SCRIBD_SYSROOT=/home/container/webdata/sysroot
# SCRIBD_SYSROOT_AUTO=0        # never fetch libraries automatically
# SCRIBD_DEB_SUITE=bookworm    # which Debian suite to take them from

# --- use a browser running somewhere else (no Chromium in the container) -----
# e.g. Chrome on your PC: chrome --remote-debugging-port=9222 --headless=new
# SCRIBD_BROWSER_CDP=http://your-pc:9222

# --- which route the jobs use on this machine -------------------------------
# auto (default): --browser only if Chromium can actually start here;
#                 without it the CLI uses its HTTP strategies
# on / off: force the Chromium route or never use it
# SCRIBD_WEB_BROWSER=auto
