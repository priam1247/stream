# ============================================================================
# WhatsApp service — Environment Configuration (.env.example)
# ============================================================================
# Copy to .env (git-ignored) or set as Pterodactyl Startup Variables.
# ROLLOUT ORDER FOR ROTATING SECRETS:
#   1. Set these variables in .env / Panel Startup Variables FIRST.
#   2. Deploy the updated bot code SECOND and verify .status / .paper / .movie.
#   3. Revoke / rotate old exposed API keys LAST.

# ── Bot Identity & Pairing ───────────────────────────────────────────────────
PREFIX=.
BOT_NAME=WhatsApp
OWNER_NUMBER=
ADMIN_NUMBERS=
# IMPORTANT: empty OWNER_NUMBER or ADMIN_NUMBERS uses old built-in privileged
# defaults. Set BOTH privately to your own international numbers instead.
# Leave PAIR_NUMBER empty to pair interactively from the web dashboard (/admin),
# or set digits with country code (e.g. 265991234567) for automatic CLI pairing:
PAIR_NUMBER=
SESSION_NAME=session
# Maximum additional linked accounts. Existing accounts are never deleted.
MAX_LINKED_ACCOUNTS=20
TZ=Africa/Blantyre

# ── Drime Cloud Past-Paper Vault (.paper / .countpapers) ─────────────────────
DRIME_API_TOKEN=
DRIME_BASE_URL=https://app.drime.cloud/api/v1
DRIME_PAPERS_FOLDER_ID=841342462
DRIME_PAPERS_FOLDER_HASH=ODQxMzQyNDYyfA
DRIME_WORKSPACE_ID=0

# ── Movies & Series Metadata / Debrid (.movie / .series) ─────────────────────
# TMDB is optional (Cinemeta, IMDb, TVMaze, Jikan, and AniList work keyless)
TMDB_API_KEY=
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
DEBRID_API_KEY=
TORRENT_DIRECT=true

# ── Media Fallbacks & YouTube (.song / .ytv / .dl) ───────────────────────────
GIFTED_API_KEY=
# Optional path on this host to your private Netscape cookies.txt. Never commit it.
YOUTUBE_COOKIES_FILE=
YTDLP_PROXY=

# ── Web Dashboard Outbound HTTPS Sync (Recommended — No Open Port Needed!) ───
# Set DASHBOARD_URL to your portal. In single-host mode use its single-host
# sync token. In failover mode use the private token for THIS host from
# WhatsApp -> Sync; XS and Botkeep must use different tokens.
DASHBOARD_URL=https://dashboard-ij71.vercel.app
BOT_SYNC_TOKEN=
DASHBOARD_SYNC_INTERVAL_MS=10000
# After both hosts have the updated code and independent WhatsApp devices:
# use xs on XS Systems and botkeep on the standby. Leave blank for single-host mode.
WHATSAPP_FAILOVER_ROLE=
# Optional primary encrypted recovery. Generate one private 32-byte base64 key
# and keep it safe outside Git and chat. In failover mode leave this BLANK on
# Botkeep: the independently linked devices must not share a recovery slot.
# Requires the updated dashboard and configured Cloudflare D1.
SESSION_BACKUP_KEY=

# Optional inbound HTTP bridge (set ADMIN_API_ENABLED=false on Hydrodactyl/Pterodactyl)
ADMIN_API_ENABLED=false
ADMIN_DASHBOARD_TOKEN=
ADMIN_API_PORT=3000
ADMIN_CORS_ORIGINS=

# ── Hydrodactyl / Pterodactyl Panel Restart (.restart command) ───────────────
# Account -> API Credentials / API Keys (`hydro_...` or `ptlc_...`).
# The panel-provided SERVER_UUID takes precedence. On XS this server is
# 381c9516; do not copy that ID or XS credentials to the Botkeep host.
# In failover mode bot-side remote power is disabled to avoid the wrong host.
PANEL_URL=https://panel.xsystemshosting.com
PANEL_SERVER_ID=
PANEL_API_KEY=

# ── Background link jobs & large-file links ──────────────────────────────────
# Bare links are ignored; use a prefixed command such as .dl <URL>. These
# settings are retained for compatibility with previously queued jobs.
INLINE_LIMIT=104857600
MEDIA_DIR=temp
RCLONE_REMOTE=
RCLONE_PATH=
# RCLONE_CONFIG=secrets/rclone.conf
# RCLONE_BIN=~/.anon/bin/rclone
JOBS_MIN_FREE_MB=800
JOBS_MAX_QUEUED=50

# ── 10 GB Plan Disk Guard & Queue Concurrency ────────────────────────────────
DISK_BUDGET_MB=9000
TEMP_MAX_MB=2048
QUEUE_LIGHT=20
QUEUE_HEAVY=2
MOVIE_CONCURRENCY=2

# The separate Scribd service has its own configuration; see its README.
