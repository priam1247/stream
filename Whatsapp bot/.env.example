# ============================================================================
# WhatsApp service — Environment Configuration (.env.example)
# ============================================================================
# Copy to .env (git-ignored) or set private Botkeep environment variables.
# ROLLOUT ORDER FOR ROTATING SECRETS:
#   1. Set these variables in .env / Panel Startup Variables FIRST.
#   2. Deploy the updated bot code SECOND and verify .status / .paper / .movie.
#   3. Revoke / rotate old exposed API keys LAST.

# ── Bot Identity & Pairing ───────────────────────────────────────────────────
PREFIX=.
BOT_NAME=WhatsApp
OWNER_NUMBER=
ADMIN_NUMBERS=
# IMPORTANT: empty OWNER_NUMBER or ADMIN_NUMBERS uses old built-in privileged
# defaults. Set BOTH privately to your own international numbers instead.
# Leave PAIR_NUMBER empty to pair interactively from the web dashboard (/admin),
# or set digits with country code (e.g. 265991234567) for automatic CLI pairing:
PAIR_NUMBER=
SESSION_NAME=session
# Maximum additional linked accounts. Existing accounts are never deleted.
MAX_LINKED_ACCOUNTS=20
TZ=Africa/Blantyre

# ── Drime Cloud Past-Paper Vault (.paper / .countpapers) ─────────────────────
# Private API token only; a copied "Bearer " prefix is also accepted. A 401
# means Drime rejected authentication: check the token and base URL privately.
DRIME_API_TOKEN=
DRIME_BASE_URL=https://app.drime.cloud/api/v1
DRIME_PAPERS_FOLDER_ID=841342462
DRIME_PAPERS_FOLDER_HASH=ODQxMzQyNDYyfA
DRIME_WORKSPACE_ID=0

# ── Movies & Series (.movie / .series) ──────────────────────────────────────
# Keyless providers work without a token. TMDB is optional metadata only.
TMDB_API_KEY=
TORRENT_DIRECT=true

# ── XJX YouTube media commands (.song / .video) ────────────────────────────
# .song/.video use XJX's YouTube resolver flow; .fb uses ApisSupreme and
# .instagram uses ruhend-scraper. These do not fall back to local yt-dlp,
# yt1d, or Cobalt. Use only credentials you own; XJX's keys are not copied.
XJX_KNIGHTBOT_API_KEY=
XJX_APISSUPREME_API_KEY=
XJX_APIX_KEY=
# ApisSupreme key also powers .fb. .song accepts 64/128/192/256/320kbps;
# KnightBot is asked for this bitrate, but actual output depends on the provider.
XJX_SONG_AUDIO_FORMAT=320kbps
# Existing APIX_KEY is also accepted for deployments that already use that name.
# Request timeout in milliseconds for XJX .song/.video and ApisSupreme .fb.
XJX_MEDIA_TIMEOUT_MS=60000
GIFTED_API_KEY=
# Optional proxy for other local media-engine commands.
YTDLP_PROXY=
# Keyless music sources need NO accounts or API keys. These only tune timeouts
# and the ±seconds window used to match a catalog track to a public upload.
MUSIC_REQUEST_TIMEOUT_MS=15000
MUSIC_SEARCH_TIMEOUT_MS=20000
MUSIC_TAG_TIMEOUT_MS=4000
MUSIC_MAX_DURATION_DRIFT=20

# ── Standalone ownMedia engine (no keys required) ───────────────────────────
# Only set the two tokens below if this host specifically needs YouTube
# attestation; they are NEVER stored in the repo. Everything else just tunes
# timeouts and size limits.
YT_PO_TOKEN=
YT_VISITOR_DATA=
OWN_MEDIA_TIMEOUT_MS=20000
OWN_MEDIA_DOWNLOAD_TIMEOUT_MS=180000
OWN_MEDIA_CLIENT_TIMEOUT_MS=90000
OWN_MEDIA_FFMPEG_TIMEOUT_MS=300000
OWN_MEDIA_MAX_AUDIO_MB=120
OWN_MEDIA_MAX_VIDEO_MB=300

# ── Dashboard Outbound HTTPS Sync (no inbound port needed) ────────────────────
# Use the dashboard's single-host sync token; keep it private.
DASHBOARD_URL=https://dashboard-ij71.vercel.app
BOT_SYNC_TOKEN=
DASHBOARD_SYNC_INTERVAL_MS=10000
# Optional encrypted recovery: keep one stable 32-byte base64 key privately.
# Requires the updated dashboard and configured Cloudflare D1.
SESSION_BACKUP_KEY=

# Optional inbound HTTP bridge; leave disabled unless you explicitly configure
# a secure Botkeep address and token on both the service and dashboard.
ADMIN_API_ENABLED=false
ADMIN_DASHBOARD_TOKEN=
ADMIN_API_PORT=3000
ADMIN_CORS_ORIGINS=

# ── Background link jobs & large-file links ──────────────────────────────────
# Bare links are ignored; use .song or .video for YouTube media, or a
# site-specific command. These settings remain for previously queued jobs.
INLINE_LIMIT=104857600
MEDIA_DIR=temp
RCLONE_REMOTE=
RCLONE_PATH=
# RCLONE_CONFIG=secrets/rclone.conf
# RCLONE_BIN=~/.anon/bin/rclone
JOBS_MIN_FREE_MB=800
JOBS_MAX_QUEUED=50

# ── Disk and memory safeguards (requests start concurrently) ─────────────────
DISK_BUDGET_MB=9000
TEMP_MAX_MB=2048
QUEUE_MIN_FREE_MB=220

# The separate Scribd service has its own configuration; see its README.
