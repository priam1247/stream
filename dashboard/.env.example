# ============================================================================
# 1. ZaFar Control Room — Session Signing & Administrator Identity
# ============================================================================
# REQUIRED in production (minimum 16 characters; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Administrator account email (controls /admin, members, and bot settings)
ADMIN_EMAIL=troykunsauka@gmail.com

# Optional initial bootstrap password for ADMIN_EMAIL on a fresh database
ADMIN_INITIAL_PASSWORD=

# ============================================================================
# 2. Cloudflare D1 Persistent Storage (accounts, grants, whitelist, activity)
# ============================================================================
# Recommended for production; local JSON may be ephemeral on serverless hosts.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================================
# 3. Verification & Password-Reset Email (pick Resend HTTP API OR Direct SMTP)
# ============================================================================
# Production account registration always requires email verification.
# Option A (recommended on Vercel / Serverless): Resend HTTP API
RESEND_API_KEY=
EMAIL_FROM=

# Option B: Direct SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional one-way legacy account migration URL (leave empty once accounts live in D1)
ZAFAR_AUTH_API_URL=

# ============================================================================
# 4. Outbound Bot Sync & Optional Hydrodactyl / Pterodactyl Panel Power Control
#    (All of these can also be saved live inside /admin -> Bot)
# ============================================================================
# Shared secret used by the bot (`POST /api/bot/sync`) — no open bot port needed!
BOT_SYNC_TOKEN=

# Optional inbound bot URL fallback (leave blank on Hydrodactyl/Pterodactyl)
BOT_API_URL=
ADMIN_DASHBOARD_TOKEN=

# Optional server-side Hydrodactyl / Pterodactyl restart controls (`hydro_...` / `ptlc_...`)
PANEL_URL=https://panel.xsystemshosting.com
PANEL_SERVER_ID=
PANEL_API_KEY=


# ============================================================================
# 5. Scribd web service (`scribd/scribd_web.py`)
# ============================================================================
# The address is built in: https://troy.hidenplay.net. SCRIBD_WEB_URL is ignored,
# including any old HTTP value; there is no address setting to update.
# Set this to the running web service's token in the deployment's secret
# settings; the service uses a token by default. Never commit the real token.
SCRIBD_WEB_TOKEN=
# The service uses a query token; configure reverse-proxy logs not to record it.
