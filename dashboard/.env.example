# ============================================================================
# 1. ZaFar Control Room — Session Signing & Administrator Identity
# ============================================================================
# REQUIRED in production (minimum 16 characters; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Administrator account email (controls /admin, members, and bot settings)
ADMIN_EMAIL=troykunsauka@gmail.com

# Optional initial bootstrap password for ADMIN_EMAIL on a fresh database
ADMIN_INITIAL_PASSWORD=

# ============================================================================
# 2. Cloudflare D1 Persistent Storage (accounts, whitelist, bot settings)
# ============================================================================
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================================
# 3. Verification & Password-Reset Email (pick Resend HTTP API OR Direct SMTP)
# ============================================================================
# Option A (recommended on Vercel / Serverless): Resend HTTP API
RESEND_API_KEY=
EMAIL_FROM=

# Option B: Direct SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional one-way legacy account migration URL (leave empty once accounts live in D1)
ZAFAR_AUTH_API_URL=

# ============================================================================
# 4. Outbound Bot Sync & Optional Hydrodactyl / Pterodactyl Panel Power Control
#    (All of these can also be saved live inside /admin -> Bot & Numbers)
# ============================================================================
# Shared secret used by the bot (`POST /api/bot/sync`) — no open bot port needed!
BOT_SYNC_TOKEN=

# Optional inbound bot URL fallback (leave blank on Hydrodactyl/Pterodactyl)
BOT_API_URL=
ADMIN_DASHBOARD_TOKEN=

# Optional server-side Hydrodactyl / Pterodactyl restart controls (`hydro_...` / `ptlc_...`)
PANEL_URL=https://panel.xsystemshosting.com
PANEL_SERVER_ID=
PANEL_API_KEY=


# ============================================================================
# 5. Scribd Library (the Python panel at tools/scribd_download.py)
#    Both can also be saved live in the Scribd tab -> "Panel settings" (D1),
#    which is the intended way: these are only the starting defaults.
# ============================================================================

# Address of the panel. No trailing slash; a ?key=… in a pasted link is ignored.
SCRIBD_PANEL_URL=http://195.123.189.187:25811
# Only needed when the panel was started with PANEL_KEY. It stays on the
# server: the browser never sees it, because /api/scribd/* proxies every call.
SCRIBD_PANEL_KEY=
# Optional: the panel's address as the BROWSER sees it. When set, Save mints a
# signed short-lived link (?t=…&e=…) straight to the panel, so big PDFs skip this
# app entirely (and Vercel's function time limit). http:// is fine: the browser
# only navigates to it. The key never appears in the URL.
SCRIBD_PUBLIC_URL=
