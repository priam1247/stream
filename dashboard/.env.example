# ============================================================================
# 1. ZaFar Control Room — Session Signing & Administrator Identity
# ============================================================================
# REQUIRED in production (minimum 16 characters; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Administrator account email (controls /admin, members, and bot settings)
ADMIN_EMAIL=troykunsauka@gmail.com

# Optional initial bootstrap password for ADMIN_EMAIL on a fresh database
ADMIN_INITIAL_PASSWORD=

# ============================================================================
# 2. Cloudflare D1 Persistent Storage (accounts, grants, whitelist, activity)
# ============================================================================
# Recommended for production; local JSON may be ephemeral on serverless hosts.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================================
# 3. Verification & Password-Reset Email (pick Resend HTTP API OR Direct SMTP)
# ============================================================================
# Production account registration always requires email verification.
# Option A (recommended on Vercel / Serverless): Resend HTTP API
RESEND_API_KEY=
EMAIL_FROM=

# Option B: Direct SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional one-way legacy account migration URL (leave empty once accounts live in D1)
ZAFAR_AUTH_API_URL=

# ============================================================================
# 4. Botkeep sync and optional Botkeep Developer API controls
#    (these can also be saved privately in the owner dashboard)
# ============================================================================
# Shared outbound sync secret; no inbound bot port needed.
BOT_SYNC_TOKEN=

# Optional Botkeep-only direct bot bridge. Explicitly configure both values;
# old generic bridge addresses are deliberately ignored.
BOTKEEP_BOT_API_URL=
BOTKEEP_BOT_ADMIN_TOKEN=

# Optional official Botkeep Developer API: enter your explicit server ID and
# a private key with workloads:read and power:write scopes. Nothing is guessed.
BOTKEEP_WORKLOAD_ID=
BOTKEEP_API_KEY=
