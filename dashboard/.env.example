# ============================================================================
# 1. ZaFar Control Room — Session Signing & Administrator Identity
# ============================================================================
# REQUIRED in production (minimum 16 characters; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# Administrator account email (controls /admin, members, and bot settings)
ADMIN_EMAIL=troykunsauka@gmail.com

# Optional initial bootstrap password for ADMIN_EMAIL on a fresh database
ADMIN_INITIAL_PASSWORD=

# ============================================================================
# 2. Cloudflare D1 Persistent Storage (accounts, grants, whitelist, activity)
# ============================================================================
# Recommended for production; local JSON may be ephemeral on serverless hosts.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================================
# 3. Verification & Password-Reset Email (pick Resend HTTP API OR Direct SMTP)
# ============================================================================
# Production account registration always requires email verification.
# Option A (recommended on Vercel / Serverless): Resend HTTP API
RESEND_API_KEY=
EMAIL_FROM=

# Option B: Direct SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional one-way legacy account migration URL (leave empty once accounts live in D1)
ZAFAR_AUTH_API_URL=

# ============================================================================
# 4. Botkeep sync and optional HiddenCloud panel controls
#    (these can also be saved privately in the owner dashboard)
# ============================================================================
# Shared outbound sync secret; no inbound bot port needed.
BOT_SYNC_TOKEN=

# Optional Botkeep-only direct bot bridge. Defaults to the service reverse
# proxy https://troy.hidenplay.net when unset; set to override, or save an
# empty URL in the dashboard to use heartbeat-only sync. Configure the token.
BOTKEEP_BOT_API_URL=
BOTKEEP_BOT_ADMIN_TOKEN=

# NOTE: HidenCloud's free tier does not include API access; client API keys are
# deleted every 30 minutes there, so these stay unset unless the plan supports it.
# Optional HiddenCloud panel (Pterodactyl-compatible client API): paste your
# client API key from Account -> API Credentials (ptlc_...), with Control
# permission. The server ID defaults to a6451c6c (troyzafarings - Free Server
# #236941); set HIDENCLOUD_SERVER_ID to target another server. The dashboard
# hardcodes the panel address (https://freepanel.hidencloud.com). Nothing is
# guessed and the key is only ever sent over HTTPS, server-side.
HIDENCLOUD_SERVER_ID=
HIDENCLOUD_API_KEY=
