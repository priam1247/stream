# ============================================================================
# zafar-bot — environment configuration
# ============================================================================
# Copy to .env (git-ignored) or set these in your host's variable panel.
# Nothing in this file is a real secret. Real values never enter Git.

# ── Identity ─────────────────────────────────────────────────────────────────
# Owner is set ONCE with `npm run add-owner -- <number>`.
# There is no built-in owner and no built-in admin fallback: with no owner set,
# the bot starts and refuses every command until you run add-owner.
BOT_NAME=WhatsApp
PREFIX=.
TZ=Africa/Blantyre

# ── Session ──────────────────────────────────────────────────────────────────
# Digits with country code, e.g. 265991234567. Leave empty to pair from the
# dashboard / QR on the console.
PAIR_NUMBER=
# Maximum number of linked accounts this deployment may hold.
MAX_LINKED_ACCOUNTS=20

# ── Dashboard (optional) ─────────────────────────────────────────────────────
# Leave empty to run fully standalone. When set, the bot pushes heartbeats.
DASHBOARD_URL=
BOT_SYNC_TOKEN=
DASHBOARD_SYNC_INTERVAL_MS=10000

# ── Commands that need a private API key ─────────────────────────────────────
# .song  — ApisSupreme audio resolver (the single path, no fallback chain)
XJX_APISSUPREME_API_KEY=
XJX_SONG_AUDIO_FORMAT=320kbps
# .video — KnightBot video resolver (the single path)
XJX_KNIGHTBOT_API_KEY=
# .fb    — ApisSupreme Facebook resolver (same key as .song)
# .ig    — ruhend-scraper, no key required
XJX_MEDIA_TIMEOUT_MS=60000

# ── .paper — Drime Cloud past-paper vault ────────────────────────────────────
DRIME_API_TOKEN=
DRIME_BASE_URL=https://app.drime.cloud/api/v1
DRIME_PAPERS_FOLDER_ID=841342462
DRIME_PAPERS_FOLDER_HASH=ODQxMzQyNDYyfA
DRIME_WORKSPACE_ID=0

# ── .movie / .series ─────────────────────────────────────────────────────────
# Keyless providers only. TMDB is metadata only and optional.
TMDB_API_KEY=
TORRENT_DIRECT=true
MOVIE_QUALITY=720
MOVIE_MAX_MB=2000
MOVIE_MAX_DOWNLOAD_MB=2000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
